# Hostinger — public_html/api/.env (Git'e eklemeyin)

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=info@edekakapi.com
SMTP_PASSWORD=BURAYA_EPOSTA_SIFRESI
SMTP_FROM=info@edekakapi.com
SMTP_FROM_NAME=Kayseri Sineklik

# İsteğe bağlı: farklı alıcı
# MAIL_TO=info@edekakapi.com

# Geçici hata ayıklama (formda SMTP hatasını gösterir)
# FORM_DEBUG=true

# Port 465 çalışmazsa:
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls
